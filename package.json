	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build",
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
